# Copia este archivo como .env y rellena los valores reales.
# Nunca subas el .env real a git (ya está en .gitignore).

# --- Backend / Spring Boot ---
DB_USERNAME=fidelyfood_app
DB_PASSWORD=
# URL JDBC completa. En local no hace falta (usa el valor por defecto de
# application.properties). En producción (Railway) usa la que da el plugin
# de MySQL, con el formato:
# jdbc:mysql://HOST:PUERTO/BASE_DE_DATOS?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_URL=

# Secreto para firmar los JWT. En local puede quedar vacío (usa el valor de
# desarrollo por defecto). En producción es OBLIGATORIO: el backend no
# arranca si el perfil "prod" está activo y esta variable no está definida.
APP_JWT_SECRET=

# URL pública del propio backend (para generar enlaces, ej. a /uploads).
APP_BASE_URL=http://localhost:8081

# Orígenes adicionales permitidos por CORS, separados por comas
# (el dominio real del frontend en producción). Los orígenes de
# desarrollo (localhost/Capacitor) siempre están permitidos.
APP_CORS_ORIGINS=

# Activa las validaciones de producción (ver JwtUtil). En Railway:
# SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=

# Contraseña usada por el seeder de restaurantes históricos (solo dev/seed).
APP_SEED_RESTAURANT_PASSWORD=

# --- Access Center (herramienta local de desarrollo, no producción) ---
ACCESS_CENTER_PORT=5757
