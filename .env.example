# Copia este archivo como .env y rellena los valores reales.
# Nunca subas el .env real a git (ya está en .gitignore).

# --- Backend / Spring Boot ---
DB_USERNAME=fidelyfood_app
DB_PASSWORD=
# URL JDBC completa. En local no hace falta (usa el valor por defecto de
# application.properties). En producción (Railway) usa la que da el plugin
# de MySQL, con el formato:
# jdbc:mysql://HOST:PUERTO/BASE_DE_DATOS?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_URL=

# Secreto para firmar los JWT. En local puede quedar vacío (usa el valor de
# desarrollo por defecto). En producción es OBLIGATORIO: el backend no
# arranca si el perfil "prod" está activo y esta variable no está definida.
APP_JWT_SECRET=

# URL pública del propio backend (para generar enlaces, ej. a /uploads).
APP_BASE_URL=http://localhost:8081

# Orígenes adicionales permitidos por CORS, separados por comas
# (el dominio real del frontend en producción). Los orígenes de
# desarrollo (localhost/Capacitor) siempre están permitidos.
APP_CORS_ORIGINS=

# Activa las validaciones de producción (ver JwtUtil). En Railway:
# SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=

# Contraseña usada por el seeder de restaurantes históricos (solo dev/seed).
APP_SEED_RESTAURANT_PASSWORD=

# --- Access Center (herramienta local de desarrollo, no producción) ---
ACCESS_CENTER_PORT=5757

# --- Apple Wallet (pase de fidelización del cliente) ---
# Certificado de Pass Type ID emitido por Apple (requiere Apple Developer
# Program). Sin estos valores, GET /api/wallet/pass responde 503 con
# instrucciones. El certificado intermedio WWDR va empaquetado en el backend.
APP_WALLET_TEAM_ID=
APP_WALLET_PASS_TYPE_ID=
APP_WALLET_CERT_PATH=
APP_WALLET_CERT_PASSWORD=

# --- Login social ---
# Client ID de Google (OAuth 2.0, gratuito: console.cloud.google.com).
# Para Apple: Services ID de web y bundle ID de iOS, separados por coma
# (requiere Apple Developer Program). Sin estos valores, /api/auth/google
# y /api/auth/apple responden 503.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_IDS=

# --- Código de acceso por SMS (OTP) ---
# Vacío (sin proveedor): no se envía ningún SMS real, el código solo se
# registra en el log del servidor. "twilio": envío real con las
# credenciales de abajo.
APP_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# "true" SOLO en tu .env local, para probar el flujo de OTP sin pagar
# Twilio: con el proveedor vacío, el código también vuelve en la respuesta
# (devCodigo). NUNCA pongas esto a "true" en producción (Render): si
# APP_SMS_PROVIDER está vacío ahí, esta variable debe faltar o ser "false",
# o cualquiera podría entrar como cualquier usuario llamando a
# POST /api/auth/otp/send y leyendo el código de su propia respuesta.
APP_SMS_DEV_EXPOSE_CODE=
